# Copy this file to .env and replace only with your own keys.
# Never upload .env to GitHub or share it publicly.

# DeepSeek: news analysis / readable article assistance. The price model itself is Python code.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Market-data providers. A key is needed only for the provider you choose.
MARKET_DATA_PROVIDER=eodhd
EODHD_API_KEY=replace_with_your_eodhd_api_key
TIINGO_API_TOKEN=replace_with_your_tiingo_api_token

# Optional macro data
FRED_API_KEY=replace_with_your_fred_api_key

# Optional intraday data provider used by the intraday sync cycle
ALPACA_API_KEY_ID=replace_with_your_alpaca_api_key_id
ALPACA_API_SECRET_KEY=replace_with_your_alpaca_api_secret_key

# Initial research symbols
TICKERS=QQQM,QQQ,SPY,TLT
QQQM_LOCAL_TIMEZONE=Asia/Hong_Kong
NEWS_CONTACT_EMAIL=replace_with_your_contact_email
